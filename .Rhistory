data.frame(crop = .y, m = m_seq, S_exp = as.numeric(riqueza))
})
rare_df <- do.call(rbind, rare_curves)
# 3) Gráfico (base R): todas las curvas superpuestas por cultivo
plot(NA, xlim = range(rare_df$m), ylim = range(rare_df$S_exp),
xlab = "Individuos muestreados (pooled)", ylab = "Riqueza esperada",
main = "Curvas de rarefacción por cultivo (pooled)")
invisible(split(rare_df, rare_df$crop) |> lapply(function(d) lines(d$m, d$S_exp, lwd = 2)))
legend("bottomright", legend = names(abund_list), lty = 1, lwd = 2, bty = "n")
library(iNEXT)
library(purrr)
library(ggplot2)
# Reutilizamos abund_list de la opción A
set.seed(123)
cap <- 2000   # límite superior del tamaño de muestra
inext_list <- purrr::imap(abund_list, ~ {
if (length(.x) == 0) return(NULL)
N <- sum(.x)
endpoint <- min(N, cap)
# Ejecutar iNEXT por cultivo con límites (sin SE para que sea ligero)
iNEXT(.x, q = 0, datatype = "abundance", endpoint = endpoint, se = FALSE, knots = 40)
})
library(iNEXT)
library(purrr)
library(ggplot2)
# Reutilizamos abund_list de la opción A
set.seed(123)
cap <- 2000   # límite superior del tamaño de muestra
inext_list <- purrr::imap(abund_list, ~ {
if (length(.x) == 0) return(NULL)
N <- sum(.x)
endpoint <- min(N, cap)
# Ejecutar iNEXT por cultivo con límites (sin SE para que sea ligero)
iNEXT(.x, q = 0, datatype = "abundance", endpoint = endpoint, se = FALSE, knots = 40)
})
View(metadato_df_0)
View(metadato_df_0)
# --- Incidence list: c(T, Q1, Q2, ...); T = nº total de muestras (incluye 0 especies) ---
incidence_list <- metadato_df_0 |>
group_split(crop) |> set_names(unique(metadato_df_0$crop)) |>
lapply(function(M) {
crop_i <- unique(M$crop)
Tm <- nrow(M)  # total samples for this crop
A  <- df |> filter(crop == crop_i) |>
select(muestra_id, code, n) |>
pivot_wider(names_from = code, values_from = n, values_fill = 0)
if (nrow(A) == 0) return(c(Tm))
mat <- as.matrix(A[ , -1, drop = FALSE])
Qi  <- colSums(mat > 0)
c(Tm, as.numeric(Qi))
})
# --- Rarefaction at common number of samples (minimum across crops) ---
n_common <- min(sapply(incidence_list, function(v) ifelse(length(v) > 0, v[1], Inf)))
div_raref <- estimateD(incidence_list, q = c(0,1,2),
datatype = "incidence_freq",
base = "size", level = n_common) |>
arrange(Assemblage, Order.q)
